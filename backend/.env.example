APP_NAME="Ever After Studio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# The public frontend origin. Used for guest links and CORS defaults.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Standalone exported invitations can be hosted anywhere. Set this to * in
# production so the download's RSVP form can post to the public API.
# CORS_ALLOWED_ORIGINS=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses XAMPP/MariaDB. Production uses a managed Postgres
# database (Neon on Vercel injects DATABASE_URL, which config/database.php reads).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wedding_invitations
DB_USERNAME=root
DB_PASSWORD=
# Production alternative: set DB_CONNECTION=pgsql and DATABASE_URL (or DB_URL).
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

# Local uploads. Use vercel_blob in production and set BLOB_READ_WRITE_TOKEN.
MEDIA_DRIVER=local
BLOB_READ_WRITE_TOKEN=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Sanctum bearer tokens (minutes). The SPA stores the token in sessionStorage.
SANCTUM_TOKEN_EXPIRATION=720

# Optional: create a specific local admin instead of the documented demo admin.
# SEED_ADMIN_NAME="Studio Administrator"
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# Never enable demo data in production.
# SEED_DEMO_DATA=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Production (set these in Vercel Project Settings, never commit them)
# ---------------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-api.vercel.app
# FRONTEND_URL=https://your-frontend.vercel.app
# CORS_ALLOWED_ORIGINS=*
# LOG_CHANNEL=stderr
# SESSION_DRIVER=database
# CACHE_STORE=database
# QUEUE_CONNECTION=sync
# DB_CONNECTION=pgsql
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# MEDIA_DRIVER=vercel_blob
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# SANCTUM_TOKEN_EXPIRATION=720
